# Application
APP_NAME=vCraft Bat Trang
DEBUG=true
SESSION_COOKIE_SECURE=false

# Media upload storage
MEDIA_ROOT=storage/media
MEDIA_MAX_BYTES=10485760
MEDIA_MAX_FILES_PER_REQUEST=10

# PostgreSQL 19 (host local dev vs Docker service `db`)
POSTGRES_USER=vcraft
POSTGRES_PASSWORD=vcraft
POSTGRES_DB=vcraft
POSTGRES_TEST_DB=vcraft_test
DATABASE_URL=postgresql+psycopg://vcraft:vcraft@localhost:5432/vcraft
TEST_DATABASE_URL=postgresql+psycopg://vcraft:vcraft@localhost:5432/vcraft_test
